{
  "name": "cc-discord-bot",
  "version": "0.1.0",
  "private": true,
  "description": "A small Discord AI assistant triggered with cc, mentions, DMs, or slash commands.",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "dev": "tsx watch src/index.ts",
    "register-commands": "tsx src/register-commands.ts",
    "start": "node --max-old-space-size=70 dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "dotenv": "17.4.2",
    "pg": "^8.13.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/pg": "^8.11.11",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
