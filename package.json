{
  "name": "cc-discord-bot",
  "version": "0.1.0",
  "private": true,
  "description": "A small Discord AI assistant triggered with cc, mentions, DMs, or slash commands.",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "deploy:zip": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rebuild-discloud-zip.ps1",
    "deploy:zip:with-env": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rebuild-discloud-zip.ps1 -IncludeEnv",
    "dev": "tsx watch src/index.ts",
    "register-commands": "tsx src/register-commands.ts",
    "start": "node --max-old-space-size=70 dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "14.28.1",
    "dotenv": "18.0.10",
    "pg": "^8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
