# Discord Bot Credentials (Required)
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_APPLICATION_ID=your_discord_application_id_here
DISCORD_GUILD_ID=your_discord_test_guild_id_here
# Optional privileged intent. Leave false unless Server Members Intent is enabled
# in the Discord Developer Portal and you need `cc manage list members`.
DISCORD_GUILD_MEMBERS_INTENT=false

# AI Provider Configuration (Required)
# Supported AI_API_STYLE options:
# 1) "google-native" — Google's official Gemini/Gemma API directly (AI_BASE_URL defaults to https://generativelanguage.googleapis.com/v1beta)
#    AI_API_STYLE=google-native
#    AI_MODEL=gemma-4-31b-it   # (or gemini-2.5-flash, gemini-1.5-flash, etc.)
#    AI_API_KEY=your_google_api_key_here
#
# 2) "responses" — OpenAI Responses API
#    AI_API_STYLE=responses
#    AI_MODEL=gpt-5-mini
#    AI_BASE_URL=https://api.openai.com/v1
#    AI_API_KEY=your_openai_api_key_here
#
# 3) "chat-completions" — OpenAI-compatible Chat Completions API (OpenRouter, Groq, Ollama, DeepSeek)
#    AI_API_STYLE=chat-completions
#    AI_MODEL=your_model_name
#    AI_BASE_URL=https://provider.example/v1
#    AI_API_KEY=your_provider_api_key_here

AI_API_KEY=your_ai_api_key_here
AI_API_STYLE=responses
AI_MODEL=gpt-5-mini
# AI_BASE_URL is optional; automatically defaults based on AI_API_STYLE
# AI_BASE_URL=https://api.openai.com/v1

# ==============================================================================
# Automatic AI Model Fallback System
# ==============================================================================
# When primary model fails due to recoverable errors (HTTP 503 service overloaded,
# HTTP 429 rate limit/quota, HTTP 502/504 gateway failures, or timeouts),
# CCai automatically attempts configured fallback models in order.
AI_FALLBACK_ENABLED=true
# Comma-separated list of fallback models tried in order (e.g. gemini-2.5-flash-lite,gemini-2.5-flash)
AI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash
# Maximum transient retries per model before switching to the next fallback (default: 1)
AI_FALLBACK_MAX_RETRIES=2
# Per-fallback model request timeout in milliseconds (default: 15000)
AI_FALLBACK_TIMEOUT_MS=15000
# Optional Circuit Breaker: skip primary model after N consecutive failures during cooldown (0 = disabled)
# AI_FALLBACK_CIRCUIT_BREAKER_THRESHOLD=3
# AI_FALLBACK_CIRCUIT_BREAKER_COOLDOWN_MS=60000

# Optional: Cross-Provider Fallback Configuration
# Configure distinct API keys, styles, and endpoints for fallback models:
# AI_FALLBACK_2_MODEL=llama-3.3-70b-versatile
# AI_FALLBACK_2_API_STYLE=chat-completions
# AI_FALLBACK_2_BASE_URL=https://api.groq.com/openai/v1
# AI_FALLBACK_2_API_KEY=your_groq_api_key_here
#
# Or configure all fallback models via JSON array:
# AI_FALLBACK_CONFIG=[{"model":"gemini-2.5-flash-lite"},{"model":"llama-3.3-70b-versatile","style":"chat-completions","baseUrl":"https://api.groq.com/openai/v1","apiKey":"your_groq_api_key"}]

# Aiven PostgreSQL Database for Persistent Memory & Abbreviations (Optional)
# Paste your Aiven Service URI here to enable memory:
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
MEMORY_ENABLED=true

# Web Search Configuration (Zero API key needed for DuckDuckGo!)
SEARCH_PROVIDER=duckduckgo
SEARCH_MAX_RESULTS=5

# General Bot Settings
BOT_PREFIX=cc
# Universal Discord Reply Context (Replies to messages from any user or bot)
REPLY_CONTEXT_ENABLED=true
# Comma-separated Discord role IDs (recommended) or exact role names allowed
# to use server management. The server owner is always allowed.
AI_ADMIN_ROLES=123456789012345678,Senior Admin
COOLDOWN_SECONDS=3
CHAT_HISTORY_ENABLED=true
MAX_HISTORY_CHARS=12000
HISTORY_TTL_MINUTES=30
