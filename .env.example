# Discord Bot Credentials (Required)
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_APPLICATION_ID=your_discord_application_id_here
DISCORD_GUILD_ID=your_discord_test_guild_id_here
# Optional privileged intent. Leave false unless Server Members Intent is enabled
# in the Discord Developer Portal and you need `cc manage list members`.
DISCORD_GUILD_MEMBERS_INTENT=false

# AI Provider Configuration (Required)
AI_API_KEY=your_ai_api_key_here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5-mini
AI_API_STYLE=responses

# Aiven PostgreSQL Database for Persistent Memory & Abbreviations (Optional)
# Paste your Aiven Service URI here to enable memory:
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
MEMORY_ENABLED=true

# Web Search Configuration (Zero API key needed for DuckDuckGo!)
SEARCH_PROVIDER=duckduckgo
SEARCH_MAX_RESULTS=5

# General Bot Settings
BOT_PREFIX=cc
# Comma-separated Discord role IDs (recommended) or exact role names allowed
# to use server management. The server owner is always allowed.
AI_ADMIN_ROLES=123456789012345678,Senior Admin
COOLDOWN_SECONDS=3
CHAT_HISTORY_ENABLED=true
MAX_HISTORY_CHARS=12000
HISTORY_TTL_MINUTES=30
